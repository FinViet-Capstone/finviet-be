{
  "SePay": {
    "BaseUrl": "https://my.sepay.vn",
    "AuthorizeUrl": "/oauth/authorize",
    "ClientId": "<sepay-oauth-client-id>",
    "ClientSecret": "<sepay-oauth-client-secret>",
    "RedirectUri": "https://localhost:7253/api/wallets/sepay/callback",
    "Scopes": "profile bank-account:read transaction:read webhook:read webhook:write webhook:delete",
    "LinkStateLifetimeMinutes": 10,
    "WebhookApiKey": "<shared-secret-finviet-generates-and-registers-with-sepay>",
    "WebhookUrl": "https://api.example.com/api/wallets/sepay/webhook",
    "WebhookName": "FinViet",
    "TimeoutSeconds": 30,
    "MaxTransactionPages": 20,
    "TransactionPageSize": 100,
    "UserApiPageSize": 5000,
    "AccessTokenExpirySkewSeconds": 120,
    "SyncOverlapDays": 3,
    "MaxRetries": 2
  }
}
